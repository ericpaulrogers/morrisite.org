@misc{woods2025montana,
  author = {Woods, Fred E.},
  title = {{Montana Saints}},
  publisher = {BYU–Idaho Department of Communication and BYU Religious Education},
  year = {2025},
  url = {https://www.byutv.org/25eb5176-31bd-4806-b5ef-96c73919a013/details},
  note = {Woods, Fred E., producer. Montana Saints. BYU–Idaho Department of Communication and BYU Religious Education, 2025. BYUtv. 40:07. A history of Latter-day Saints in Montana. The opening titles say it was “collaboratively created by” the two departments, and the closing credits call it a companion to a forthcoming book of the same title by Woods and Brian Q. Cannon; Woods’s BYU faculty page names him as its producer. With thanks to John Dye, whose comment on one of the editor’s Facebook posts led to the film and to its BYU–Idaho credit. About two minutes, from roughly 6:30, touch on the Morrisites: Joseph Morris as a convert who “felt called to be a prophet,” the move north to Idaho and Montana, settlement in the Deer Lodge Valley, and the Lord’s House, called a temple, still standing “in the middle of a pasture”; a Deer Lodge descendant then speaks of the Morrisite, Reorganized and Latter-day Saint families there as all related. The film says the Morrisites called the valley “the Heavenly City”; that name has not been found in the church’s records read for this guide, which speak of gathering to Montana and of Stakes No. 1 and No. 2; it is Anderson’s own title for his chapter on Deer Lodge (Revisited, ch. 15), given without a source, apparently for George Williams’s “City of the great King,” which he said would come down in the region the Montana Saints called “the Sides of the North” (see the Glossary). “Temple” has better grounds: George Williams called the building “a Temple in miniature” in 1878.},
  keywords = {Video, audio, and web resources}
}

