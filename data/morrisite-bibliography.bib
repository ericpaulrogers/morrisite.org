@mastersthesis{wright2004mormon,
  author = {Wright, Julie A.},
  title = {{Mormon Movement to Montana}},
  school = {University of Montana},
  year = {2004},
  url = {history.html\#c-1897-racetrack},
  note = {Wright, Julie A. “Mormon Movement to Montana.” Master’s thesis, University of Montana, 2004. Pages 32–38 treat the Morrisites and the RLDS. Drawing on the Butte District manuscript history of the Northwestern States Mission (Church History Library), it reports Latter-day Saint missionaries’ visits to the Morrisites at Willow Glen in 1896 and at Racetrack about a year later. The Montana Mission manuscript history (Church History Library, LR 5693 2) has these entries; the words Wright quotes from Hendrikson’s sermon of September 19, 1897, partly paraphrase it (see the Chronology). It also summarizes a family history of Niels R. Beck (see his page). Its brief account of 1862 places the siege at Manti; it took place at Kington Fort on the Weber River. It calls Deer Lodge “the Heavenly City,” after Anderson (see Common errors above); records the name “Morrisite rain” for the rain of June 14, 1862, with the papers of a posse member’s daughter as its source; and reproduces a portrait of Andrew Hendrikson, “courtesy of Grace Bingham” (p. 36). Wright speaks in Montana Saints. Online},
  keywords = {Theses}
}

