@misc{banks1909document,
  author = {Banks, John},
  title = {{A Document History of the Morrisites in Utah}},
  publisher = {University of Utah},
  year = {1909},
  url = {repositories.html},
  note = {Banks, John. “A Document History of the Morrisites in Utah.” BA thesis, University of Utah, 1909. 94 pp.; the preface is signed “J. B.,” Salt Lake City, September 19, 1908. Built largely on Dove’s “History of Events” and on Morris’s revelations, both lent by L. C. Larsen of Deer Lodge, with transcripts of the court papers of May and June 1862 (the writs of habeas corpus and attachment, and the affidavits of Judson L. Stoddard, Hans O. Hanson and Philo Allen), the requisition for a posse and the acting governor’s orders, Burton’s proclamation of June 13, Burton’s testimony of 1879, the Deseret News of June 18 and 25, 1862, and the pardons of March 31, 1863. Banks added statements he gathered in 1908 from former Morrisites (William J. Jones, Hans O. Hanson, Philip Hewitt, Mary Anderson, Emma Just), from men of the posse and earlier sheriffs’ parties (Wells Smith, Thomas Abbott, Dan Camomile, James Ashman, William H. Hunt, Joseph E. Romney, John C. Thompson), and from Henry and Jane Firth of South Weber. The author was John Ray Banks (1881–1940) of Pleasant Grove, a grandson of the Morrisite John Banks through his son Franklin Cyrus Banks (FamilySearch Family Tree, KWVR-2WN); the university’s student paper lists “John R. Banks ’09” among its graduates, with a place that matches his in the 1910 census (“Graduate Catalogue,” University of Utah Chronicle, September 28, 1909, p. 5). His younger brother was Karl Banks (see Newspapers and Repositories). The scan’s text layer is poor; read the page images. Online},
  keywords = {Theses}
}

