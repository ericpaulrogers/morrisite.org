@article{saltlakeherald18790221,
  title = {{The Burton Trial}},
  journal = {Salt Lake Herald},
  year = {1879},
  month = feb,
  day = {21},
  date = {1879-02-21},
  url = {https://newspapers.lib.utah.edu/details?id=11621391},
  note = {Salt Lake Herald, February 21 – March 6, 1879. “The Burton Trial,” daily reports of Burton’s trial for the murder of Isabella Bowman. The fullest account in the free archives. Former Morrisites testified for the prosecution and gave their homes in 1879. Among them were James Bowman (of Soda Springs since 1863), Mrs. Mary Anderson (of Soda Springs), Caroline Eliason, Mrs. Emma Just (of the Snake River valley, Oneida County, Idaho), Jacob Johnson, Thomas Williams (of Ogden since 1865), Philip Hewitt (Salt Lake City) and a man from Hyrum whose name the scan garbles. Men of the posse also took the stand, among them Christopher Sproat, William H. Hunt and Dan Camomile. The defense called Thomas Abbott of Farmington, Robert W. Burton of Kaysville, John C. Thompson of Riverdale and Burton himself. Abraham Taylor, one of the seven convicted in 1863, testified near the close (reported March 4). The Ogden Junction of February 22 names another prosecution witness, Joseph Warner, born in Germany, who told the court of a vision of Joseph Smith at Providence that had got him cut off from the Latter-day Saint church, read a sermon of his own and recited a revelation. The text of these scans is poor, and the names are as read from it. Other links: Feb. 22: https://newspapers.lib.utah.edu/details?id=11617087; Feb. 25: https://newspapers.lib.utah.edu/details?id=11624304; Feb. 26: https://newspapers.lib.utah.edu/details?id=11641815; Feb. 27: https://newspapers.lib.utah.edu/details?id=11631853; Feb. 28: https://newspapers.lib.utah.edu/details?id=11617056; Mar. 1: https://newspapers.lib.utah.edu/details?id=11620191; Mar. 2: https://newspapers.lib.utah.edu/details?id=11629072; Mar. 4: https://newspapers.lib.utah.edu/details?id=11625418; Mar. 6: https://newspapers.lib.utah.edu/details?id=11636567 Listed on https://morrisite.org/newspapers.html\#np-1877},
  keywords = {Burton’s arrest and trial, 1877–1879}
}

