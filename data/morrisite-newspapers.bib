@article{helenaweeklyherald18800422,
  title = {{A Little Girl Burned to Death}},
  journal = {Helena Weekly Herald},
  year = {1880},
  month = apr,
  day = {22},
  date = {1880-04-22},
  pages = {7},
  url = {https://www.loc.gov/resource/sn84036143/1880-04-22/ed-1/?sp=7},
  note = {Helena Weekly Herald, April 22, 1880, p. 7. “A Little Girl Burned to Death.” Reprints the New North-West’s account of the death of the five-year-old daughter of Andrew Hendrickson, later president of the Montana Morrisites, at the family’s farm a few miles from Deer Lodge: her clothes caught fire from burning rubbish in the yard, and she lived twelve hours. A county obituary index gives the death as April 15, 1880, aged 5, and the child is buried at Hillcrest Cemetery, Deer Lodge, as Maggie Hendrickson (1875–1880). In England George Williams heard of it within weeks: on June 21, 1880, he wrote to William James of the “general mourning \& sorrow” the news had cast and sent his sympathy to the Hendricksons (Church History Library, MS 31876). Listed on https://morrisite.org/newspapers.html\#np-1891},
  keywords = {1880–1900 and the 1891 letters}
}

