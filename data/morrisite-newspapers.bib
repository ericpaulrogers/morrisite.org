  month = may,
  day = {7},
  date = {1954-05-07},
  pages = {7},
  url = {https://www.newspapers.com/image/959304852/},
  note = {Silver State Post (Deer Lodge, Mont.), May 7, 1954, p. 7. “George Johnson Sr’s Last Rites Sunday, Burial in Hillcrest.” Johnson died on the morning of Thursday, April 29, 1954, at ninety-eight. An Episcopal priest conducted the funeral, quoting the words Johnson had used at funerals “as a minister of the Morrisite faith,” and he was buried in Hillcrest cemetery beside his wife, who died in 1907. The paper calls the Morrisite church “almost extinct these days.” Newspapers.com links need a subscription. Listed on https://morrisite.org/newspapers.html\#np-1954},
  keywords = {The end of the Montana church, 1954–1962}
}

