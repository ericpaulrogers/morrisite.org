  day = {3},
  date = {1886-09-03},
  pages = {3},
  url = {https://www.loc.gov/resource/sn84038125/1886-09-03/ed-1/?sp=3},
  note = {New North-West, September 3, 1886, p. 3. Also February 19 and March 26, 1886, p. 3. “A Mormon Church, of the Morrisite branch, we are informed, is being constructed under the superintendence of Elder Clapp on the Cottonwood road about a half mile east of town.” An Elder J. C. Clapp had preached at the Deer Lodge court house in February and March 1886, once on the “Origin of the American Indians,” a Book of Mormon theme. The Morrisites’ own minutes settle the question: in November 1886 their council recorded an invitation from “Elder Clapp of the Reorganized Church” to use that church’s meeting house at Deer Lodge City while he was preaching in Utah (Church History Library, MS 32226, minutebook, pp. 37–38). The building was the Reorganized Church’s, not a Morrisite church; Clapp was very probably the RLDS missionary Joseph C. Clapp. Other links: Chronicling America: https://www.loc.gov/resource/sn84038125/1886-02-19/ed-1/?sp=3; Chronicling America: https://www.loc.gov/resource/sn84038125/1886-03-26/ed-1/?sp=3 Listed on https://morrisite.org/newspapers.html\#np-1891},
  keywords = {1880–1900 and the 1891 letters}
}

@article{saltlaketribune18910705,
  title = {{Charity for the Mormons}},
  journal = {Salt Lake Tribune},
  year = {1891},
  month = jul,
  day = {5},
  date = {1891-07-05},
  pages = {10},
  url = {https://newspapers.lib.utah.edu/details?id=12467161},
  note = {Salt Lake Tribune, May 31 to July 5, 1891. “Charity for the Mormons,” letters 1–6 of “The Elder”: May 31, p. 10 (“Charity for the Mormons”); June 7, p. 16 (“Church of God and Kingdom of God”); June 14, p. 17 (“The Apostles Ancient and Modern”); June 21, p. 3 (“The Priesthood Mistake”); June 28, p. 20 (“A Church That Is Fallen”); July 5, p. 3 (“Are the Mormons Sincere?”). The first six letters, on the Latter-day Saint church: the first is signed “an Elder of the Old-time Church, and a friend to the Mormon people,” and calls 1891 “a year of expectancy of great things.” The second argues that the kingdom of God is yet to come (the letter John R. Eardley described as Parson’s, on “the difference existing between a church and a kingdom”). The third calls Joseph Morris “a reforming prophet,” “one of the most innocent, meek, and inoffensive men that ever lived,” who went to Brigham Young and each of the apostles. The fourth teaches priesthood by birthright, to be shown by a prophet with the Urim and Thummim. The sixth urges that Joseph Smith III be invited to lead a united church and says the first Morrisites were cut off for refusing to testify that Brigham Young was a prophet. Other links: June 7: https://newspapers.lib.utah.edu/details?id=12468328; June 14: https://newspapers.lib.utah.edu/details?id=12469486; June 21: https://newspapers.lib.utah.edu/details?id=12470422; June 28: https://newspapers.lib.utah.edu/details?id=12471745; July 5: https://newspapers.lib.utah.edu/details?id=12472799 Listed on https://morrisite.org/newspapers.html\#np-1891},
  keywords = {1880–1900 and the 1891 letters}
}

