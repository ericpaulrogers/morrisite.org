  month = jan,
  day = {15},
  date = {1954-01-15},
  pages = {2},
  url = {https://www.newspapers.com/image/959304184/},
  note = {Silver State Post (Deer Lodge, Mont.), January 15, 1954, p. 2. A feature on George Johnson, then 97. Johnson’s own story as the paper told it: born near Copenhagen in 1856, he came to Council Bluffs at fifteen, became a Morrisite minister, crossed to Montana by wagon train with Andrew Hendrickson, reaching it “early in 1874,” and preached in family homes as Hendrickson’s assistant before he was ordained and the two led in building the church. His obituary and a 1956 article give 1873 for the journey. Newspapers.com links need a subscription. Listed on https://morrisite.org/newspapers.html\#np-1954},
  keywords = {The end of the Montana church, 1954–1962}
}

